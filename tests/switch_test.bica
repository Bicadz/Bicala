# Test switch statement

x = 1

switch x:
    1:
        say "one"

    2:
        say "two"

    default:
        say "other"

# Test with different value
x = 2

switch x:
    1:
        say "one"

    2:
        say "two"

    default:
        say "other"

# Test with default
x = 3

switch x:
    1:
        say "one"

    2:
        say "two"

    default:
        say "other"

# Test with string
s = "hello"

switch s:
    "hello":
        say "greeting"

    "bye":
        say "farewell"

    default:
        say "unknown"
