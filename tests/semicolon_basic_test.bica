# Basic semicolon tests

# CASE 1: Zero-argument functions
say
say;

# CASE 2: Multiple statements on one line
say "a"; say "b"

# CASE 3: Assignment context
x : 10; say x

# CASE 4: Mix with operators
x : 10 + 5; say x
# Test deep nesting (CASE 5)
# Lồng 2 tầng - cần test với function thực tế
import math
# math.sqrt math.sqrt 16; 25
# Đây là ví dụ từ design doc, nhưng cần function thực tế

# Test với string join
import str
# str.join str.join "a", "b"; "c"



# Test nested function calls with semicolon

# Simple nested call
import math
say math.sqrt 16;

# Nested in assignment
x : math.sqrt 25; say x

# Multiple statements
x : 10; y : 20; say x + y