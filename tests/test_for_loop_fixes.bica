# Test case 1: for i in 1:10 should execute 10 times
say "Test 1: for i in 1:10"
count = 0
for i in 1:10
    count = count + 1
    say "  i = " + i
say "  Total iterations: " + count
say ""

# Test case 2: for i in 1:10 should properly bind loop variable in body
say "Test 2: for i in 1:10 with say using i"
for i in 1:3
    say "  i = " + i
say ""

# Test case 3: If i = 0 is predefined globally, for i in 1:10 should update i
say "Test 3: Predefined i = 0, then for i in 1:10"
i = 0
say "  Before loop: i = " + i
for i in 1:3
    say "  Inside loop: i = " + i
say "  After loop: i = " + i
say ""

# Test case 4: for i in 1:10:pass should not throw "[S001] Expected expression Got: pass"
say "Test 4: for i in 1:10:pass"
for i in 1:3:pass
say "  Loop completed with pass"
say ""

# Additional test: Verify the loop variable is properly scoped
say "Test 5: Loop variable scoping"
for j in 1:3
    say "  Inside loop: j = " + j
say "  After loop, j should be undefined or last value"
say ""
